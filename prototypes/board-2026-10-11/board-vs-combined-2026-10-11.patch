+        // Windowed only: if the window (frame included) is larger than the desktop work area, shrink and move it
+        // so the whole client, including the bottom HUD bar, sits above the taskbar. OnGUI lays out from Screen.height.
+        IEnumerator FitWindowToWorkArea() {
+#if UNITY_STANDALONE_WIN && !UNITY_EDITOR
+            for (int i = 0; i < 3; i++) yield return null;
+            if (Screen.fullScreenMode == FullScreenMode.ExclusiveFullScreen || Screen.fullScreenMode == FullScreenMode.FullScreenWindow) yield break;
+            var hwnd = System.Diagnostics.Process.GetCurrentProcess().MainWindowHandle;
+            if (hwnd == IntPtr.Zero || IsZoomed(hwnd)) yield break;
+            var work = new WinRect();
+            if (!SystemParametersInfo(0x0030 /* SPI_GETWORKAREA */, 0, ref work, 0)) yield break;
+            if (!GetWindowRect(hwnd, out var win) || !GetClientRect(hwnd, out var client)) yield break;
+            int frameW = (win.Right - win.Left) - client.Right, frameH = (win.Bottom - win.Top) - client.Bottom;
+            int workW = work.Right - work.Left, workH = work.Bottom - work.Top;
+            bool fits = win.Left >= work.Left - 8 && win.Top >= work.Top && win.Right <= work.Right + 8 && win.Bottom <= work.Bottom + 8;
+            if (fits) yield break;
+            int w = Mathf.Min(win.Right - win.Left, workW), h = Mathf.Min(win.Bottom - win.Top, workH);
+            SetWindowPos(hwnd, IntPtr.Zero, work.Left + (workW - w) / 2, work.Top, w, h, 0x0004 | 0x0010 /* NOZORDER | NOACTIVATE */);
+            Debug.Log($"WINDOW_FIT {win.Right - win.Left}x{win.Bottom - win.Top} -> {w}x{h} (work area {workW}x{workH}, frame {frameW}x{frameH})");
+#else
+            yield break;
+#endif
