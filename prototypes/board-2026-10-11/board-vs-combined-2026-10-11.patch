+                hoverInfo = HoverText(new Vector2Int(ch.X, ch.Y), ch);
+                rig.Look(ch.transform.position, -20, 42, 6.5f, true); yield return new WaitForSeconds(.6f);
+                yield return Shot(dir, "02-board-selection-markers.png");
